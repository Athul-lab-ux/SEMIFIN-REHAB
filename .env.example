# ==============================================================================
# RehabOpt AR — Environment Configuration (.env)
# ==============================================================================

# 1. Flask Secret Key (MANDATORY on Render production)
# Secret key used for cryptographic session signing and cookie protection.
# Generate a secure 64-char hex key via: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-secure-random-32-byte-hex-string

# 2. Controller / Owner Password (MANDATORY to activate SP_OWNER_1 account)
# If omitted or empty, the Controller account is not seeded or updated.
OWNER_PASSWORD=SetYourOwnerPasswordHere123!

# 3. PostgreSQL External Database URL (MANDATORY for persistence across Render restarts)
# Connect to Neon Postgres or Supabase:
# Neon: postgresql://username:password@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
# Supabase: postgresql://postgres:password@db.xxx.supabase.co:5432/postgres
DATABASE_URL=

# 4. Flask Environment Mode ('production' or 'development')
FLASK_ENV=production

# 5. Quick Demo Logins Toggle
# Set to '1' to show 1-click Quick Demo and Controller buttons on /login page; '0' to hide.
ALLOW_DEMO_LOGINS=0

# 6. Optional: Gemini API Key for AI SOAP clinical summary generator
GEMINI_API_KEY=
